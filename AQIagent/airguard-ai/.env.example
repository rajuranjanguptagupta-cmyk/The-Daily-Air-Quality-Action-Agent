# =====================================================
# AirGuard AI — Environment Variables
# =====================================================
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.

# ----- Flask -----
FLASK_DEBUG=true
PORT=5000
SECRET_KEY=change-me-to-a-random-string

# ----- Groq (Primary LLM — fast & free tier available) -----
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# ----- Database -----
# SQLite (default — no extra setup needed):
DB_PATH=airguard.db
# PostgreSQL (optional — uncomment and fill):
# DATABASE_URL=postgresql://user:password@localhost:5432/airguard

# ----- AQI Data API -----
# Get a free token at https://aqicn.org/data-platform/token/
WAQI_TOKEN=

# ----- IBM watsonx -----
# https://dataplatform.cloud.ibm.com/
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSONX_API_KEY=
IBM_WATSONX_PROJECT_ID=
IBM_MODEL_ID=ibm/granite-13b-instruct-v2

# ----- IBM Orchestrate (optional) -----
# https://www.ibm.com/products/ibm-orchestrate
IBM_ORCHESTRATE_API_KEY=
IBM_ORCHESTRATE_URL=

# ----- IBM Langflow (optional) -----
# https://langflow.ibm.com
IBM_LANGFLOW_API_KEY=
IBM_LANGFLOW_URL=
